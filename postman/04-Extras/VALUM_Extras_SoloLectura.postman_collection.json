    {
      "name": "02 — Hot Chocolate GraphQL",
      "description": "Consultas exclusivamente a /graphql: listados, filtros, detalle, paginación y errores. Guarda snapshots de IDs para comparar con Cursor Pagination.",
      "item": [
        {
          "name": "05 — projects | página 1 (2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{vxCid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/graphql",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query { projects(page: 1, pageSize: 2) { items { id name status } page pageSize totalCount totalPages hasPrevious hasNext } }\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cid = pm.response.headers.get(\"X-Correlation-ID\");",
                  "pm.test(\"X-Correlation-ID devuelto y válido\", () => pm.expect(cid).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i));",
                  "pm.test(\"CorrelationId coincide con el enviado\", () => pm.expect(cid.toLowerCase()).to.eql(pm.collectionVariables.get(\"vxCid\").toLowerCase()));",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"GraphQL sin errores\", () => pm.expect(b.errors || []).to.be.empty);",
                  "const p=b.data.projects;",
                  "pm.test(\"Shape y metadatos correctos\", () => { pm.expect(p.items).to.be.an(\"array\"); pm.expect(p.page).to.eql(1);pm.expect(p.pageSize).to.eql(2);pm.expect(p.totalCount).to.be.a(\"number\");pm.expect(p.totalPages).to.be.a(\"number\");pm.expect(p.hasNext).to.be.a(\"boolean\");});",
                  "pm.test(\"Datos para las pruebas de cursor (>=3 proyectos)\", () => pm.expect(p.totalCount, \"Use DB con >= 3 proyectos\").to.be.at.least(3));",
                  "pm.collectionVariables.set(\"vxGqlFirstIds\",JSON.stringify(p.items.map(i=>i.id.replace(/-/g, \"\").toLowerCase())));",
                  "if(p.items.length){const hex=p.items[0].id.replace(/-/g, \"\").toLowerCase();pm.collectionVariables.set(\"vxProjectId\", hex.replace(/^(.{8})(.{4})(.{4})(.{4})(.{12})$/, \"$1-$2-$3-$4-$5\"));}",
                  "if(p.items.length>1){const hex=p.items[1].id.replace(/-/g, \"\").toLowerCase();pm.collectionVariables.set(\"vxOtherProjectId\", hex.replace(/^(.{8})(.{4})(.{4})(.{4})(.{12})$/, \"$1-$2-$3-$4-$5\"));}"
                ]
              }
            }
          ]
        },
