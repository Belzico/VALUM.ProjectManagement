        {
          "name": "04 Empty name — 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/projects",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"description\": \"Created by Postman acceptance suite\",\n  \"ownerId\": \"{{ownerId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const STATUS = 400, ERROR = \"ValidationException\";",
                  "const e = pm.response.json();",
                  "pm.test(\"VALUM error contract\", () => {",
                  "  pm.expect(e).to.be.an(\"object\");",
                  "  pm.expect(Object.keys(e).sort()).to.eql([\"details\",\"error\",\"message\",\"status\"]);",
                  "  pm.expect(e.status).to.eql(STATUS);",
                  "  pm.expect(e.error).to.eql(ERROR);",
                  "  pm.expect(e.message).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(e.details).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"HTTP status\", () => pm.response.to.have.status(STATUS));",
                  "pm.test(\"Error reports field Name\", () => {",
                  "  const fields = pm.response.json().details.map(d => String(d.field || \"\").toLowerCase());",
                  "  pm.expect(fields).to.include(\"name\");",
                  "});"
                ]
              }
            }
          ]
        },
