{
  "info": {
    "_postman_id": "9bfd5d3d-171c-4c67-9306-9eebbe22fd7e",
    "name": "VALUM API — Projects | Grupo 2",
    "description": "Independent acceptance tests for VALUM Group 2. Run in order using Collection Runner against a disposable development SQLite database. Creates several projects; never run against production. Open the README for setup and limitations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 — Create & validation (POST)",
      "item": [
        {
          "name": "01 Create primary project — 201 + save projectId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/projects",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{projectName}}\",\n  \"description\": \"Created by Postman acceptance suite\",\n  \"ownerId\": \"{{ownerId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"projectName\", \"{{runTag}}-Main\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.test(\"Created project contract\", () => {",
                  " pm.expect(p.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  " pm.expect(p.name).to.eql(pm.variables.replaceIn(\"{{projectName}}\"));",
                  " pm.expect(p.ownerId.toLowerCase()).to.eql(pm.environment.get(\"ownerId\").toLowerCase());",
                  " pm.expect(p.status).to.eql(0);",
                  " pm.expect(new Date(p.createdAt).toString()).not.to.eql(\"Invalid Date\");",
                  "});",
                  "pm.test(\"Location identifies created project\", () => {",
                  " const location=pm.response.headers.get(\"Location\") || \"\";",
                  " pm.expect(location).to.include(\"/api/projects/\"+p.id);",
                  "});",
                  "pm.environment.set(\"projectId\",p.id);",
                  "pm.environment.set(\"projectNameActual\",p.name);"
                ]
              }
            }
          ]
        },
