    {
      "name": "02 — List, filters & pagination (GET)",
      "item": [
        {
          "name": "01 Default list — 200 + metadata",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/projects",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Paged result contract\", () => {",
                  " pm.expect(data.items).to.be.an(\"array\");",
                  " for (const k of [\"page\",\"pageSize\",\"totalCount\",\"totalPages\"]) pm.expect(data[k]).to.be.a(\"number\");",
                  " for (const k of [\"hasPrevious\",\"hasNext\"]) pm.expect(data[k]).to.be.a(\"boolean\");",
                  " pm.expect(data.totalPages).to.eql(Math.ceil(data.totalCount / data.pageSize));",
                  " pm.expect(data.hasPrevious).to.eql(data.page > 1);",
                  " pm.expect(data.hasNext).to.eql(data.page < data.totalPages);",
                  " pm.expect(data.items.length).to.be.at.most(data.pageSize);",
                  "});",
                  "pm.test(\"Defaults and created project visible\", () => {",
                  " pm.expect(data.page).to.eql(1);pm.expect(data.pageSize).to.eql(10);",
                  " pm.expect(data.totalCount).to.be.at.least(4);",
                  "});"
                ]
              }
            }
          ]
        },
